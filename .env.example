# Copy to .env and fill in your OWN credentials. Never commit .env.
# Load it with:  set -a; source .env; set +a

# Optional: Qloo personalization (falls back to local demo recommendations)
QLOO_API_KEY=
# QLOO_API_BASE_URL=            # only if your Qloo key is for a different host

# Optional: NVIDIA Nemotron, informational comparison only
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
NVIDIA_API_BASE_URL=

# Amazon Bedrock (recommended; falls back to the deterministic compiler)
AWS_PROFILE=
PACT_AWS_REGION=us-west-2
PACT_BEDROCK_ENABLED=0
PACT_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Server
PACT_TOKEN_SECRET=
PACT_HOST=
PACT_PORT=
PACT_SQLITE_PATH=pact-data.sqlite3
PACT_RATE_LIMIT_PER_MINUTE=120
PACT_BEDROCK_DAILY_CAP=100
PACT_BEDROCK_TOKEN_CAP=70000
PACT_COOKIE_SECURE=0
# Payments are simulation-only in this product pass. No raw card credentials are accepted.
PACT_PAYMENT_PROVIDER=mock
# Optional Amazon Pay Checkout v2 Sandbox provider. Keep mock for local demos;
# no secret values belong in this file or in browser code.
AMAZON_PAY_ENV=sandbox
AMAZON_PAY_REGION=na
AMAZON_PAY_MERCHANT_ID=
AMAZON_PAY_PUBLIC_KEY_ID=
AMAZON_PAY_PRIVATE_KEY_PATH=
# Test-only mock outcome: success, declined, abandoned, or cancelled.
PACT_MOCK_PAYMENT_OUTCOME=success
# Development/test compatibility only. Keep 0 for the normal account product.
PACT_DEMO_MODE=0
PACT_DYNAMODB_TABLE=

# Optional server-side speech output. Browser speech synthesis remains the default/fallback.
PACT_TTS_PROVIDER=browser
PACT_POLLY_REGION=us-west-2
PACT_POLLY_ENGINE=neural
PACT_POLLY_VOICE_ID=Joanna
PACT_TTS_CACHE_DIR=.pact-cache/tts
PACT_TTS_MAX_CHARS=1200
PACT_TTS_CACHE_TTL_SECONDS=604800

# Product discovery. The local sandbox catalog is the only verified provider.
PRODUCT_CATALOG_PROVIDER=mock
PRODUCT_CATALOG_REGION=US
PRODUCT_CATALOG_MAX_RESULTS=20
CREATORS_API_ENABLED=0
CREATORS_API_KEY=
CREATORS_API_BASE_URL=

# Optional, isolated Alexa Custom Skill adapter. Not deployed by this project.
PACT_ALEXA_MCP_URL=
PACT_ALEXA_ACCOUNT_LINK_URL=
