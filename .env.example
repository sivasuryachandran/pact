# Copy to .env and fill in your OWN credentials. Never commit .env.
# Load it with:  set -a; source .env; set +a

# Optional: Qloo personalization (falls back to local demo recommendations)
QLOO_API_KEY=
# QLOO_API_BASE_URL=            # only if your Qloo key is for a different host

# Optional: NVIDIA Nemotron, informational comparison only
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
NVIDIA_API_BASE_URL=

# Amazon Bedrock (recommended; falls back to the deterministic compiler)
AWS_PROFILE=
PACT_AWS_REGION=us-west-2
PACT_BEDROCK_ENABLED=0
PACT_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Server
PACT_TOKEN_SECRET=
PACT_HOST=
PACT_PORT=
PACT_SQLITE_PATH=pact-data.sqlite3
PACT_RATE_LIMIT_PER_MINUTE=120
PACT_BEDROCK_DAILY_CAP=100
PACT_BEDROCK_TOKEN_CAP=70000
PACT_COOKIE_SECURE=0
PACT_DYNAMODB_TABLE=
