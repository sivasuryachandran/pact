{
  "name": "pact-household-gateway-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:signal && npm run build:ui",
    "build:signal": "npm --prefix pact-signal run build",
    "test:signal": "npm --prefix pact-signal run test",
    "e2e:signal": "npm --prefix pact-signal run e2e",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "build:ui": "vite build --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/three-morpho": "npm:@types/three@0.169.0",
    "@vitejs/plugin-react": "6.1.2",
    "motion": "14.3.0",
    "pact-signal": "file:./pact-signal",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "three-morpho": "npm:three@0.169.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
